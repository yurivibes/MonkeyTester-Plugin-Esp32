# User unit (Linux), esp32-sensor plugin: owns the `role: sensor` boards.
# Install:
#   cp packaging/systemd/monkeytester-esp32-sensor.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now monkeytester-esp32-sensor
# Edit WorkingDirectory to this checkout. The user must be in the `dialout`
# group. Run the esp32-server unit alongside this one; the two plugins split
# the boards by role and share the console locks (ESP32_LOCK_DIR, default
# /tmp/vt-esp32-locks) and the role cache (ESP32_ROLE_CACHE, default
# /tmp/vt-esp32-roles.json).
[Unit]
Description=MonkeyTester esp32-sensor device plugin (:8091)
After=network-online.target

[Service]
WorkingDirectory=%h/Workspace/MonkeyTester-Esp32-Sensor
ExecStart=/usr/bin/env nix run .
# Network access (SECURITY.md): the plugin API listens on 127.0.0.1 by default,
# which is what the viewer on this host uses (http://127.0.0.1:8091). To expose it
# on the LAN, set BOTH lines below; without a token (>= 16 chars) the plugin
# refuses to start on a non-loopback address. Prefer a drop-in
# (systemctl --user edit monkeytester-esp32-sensor) so the token stays out of
# this file, and enter the same token in the viewer's Settings.
#Environment=PLUGIN_BIND=0.0.0.0
#Environment=PLUGIN_TOKEN=<openssl rand -hex 32>
# Extra directories `flash` may read firmware from (default: this checkout,
# the upload dir and /nix/store):
#Environment=ESP32_FIRMWARE_ROOTS=%h/Workspace/Esp32-Sensor
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

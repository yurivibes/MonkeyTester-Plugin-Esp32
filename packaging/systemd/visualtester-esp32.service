# User unit (Linux). Install:
#   cp packaging/systemd/visualtester-esp32.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now visualtester-esp32
# Edit WorkingDirectory to this checkout. The user must be in the `dialout` group.
[Unit]
Description=VisualTester-Esp32 device plugin (:8091)
After=network-online.target

[Service]
WorkingDirectory=%h/Workspace/VisualTester-Esp32
ExecStart=/usr/bin/env nix run .
Environment=PLUGIN_PORT=8091
# Fake hub (when no hub board is attached): HTTP on 8092, mDNS tshub-fake.
# Open TCP 8092 and UDP 5353 to the LAN.
#Environment=ESP32_FAKE_HUB=auto
#Environment=ESP32_FAKE_HUB_PORT=8092
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS LaunchAgent, esp32-sensor plugin: owns the `role: sensor` boards.
     Replace CHECKOUT_DIR and PYTHON (a python with pyserial and esptool), copy
     to ~/Library/LaunchAgents/, then:
     launchctl load ~/Library/LaunchAgents/com.blackjackfruit.trustthetest-esp32-sensor.plist
     Run the esp32-server LaunchAgent alongside; the two plugins split the
     boards by role and share the console locks and the role cache (files
     under /tmp by default: /tmp/vt-esp32-locks, /tmp/vt-esp32-roles.json). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.blackjackfruit.trustthetest-esp32-sensor</string>
  <key>ProgramArguments</key>
  <array>
    <string>PYTHON</string>
    <string>CHECKOUT_DIR/esp32_plugin.py</string>
  </array>
  <key>WorkingDirectory</key><string>CHECKOUT_DIR</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PLUGIN_PORT</key><string>8091</string>
    <key>PATH</key><string>CHECKOUT_DIR/.venv/bin:/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/trustthetest-esp32-sensor.log</string>
  <key>StandardErrorPath</key><string>/tmp/trustthetest-esp32-sensor.log</string>
</dict>
</plist>
